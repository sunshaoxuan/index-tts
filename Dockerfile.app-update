ARG BASE_IMAGE=indextts25-product-studio:1.1.0

FROM node:24.10.0-bookworm-slim AS web

WORKDIR /build/product-studio
RUN corepack enable
COPY product-studio/package.json product-studio/pnpm-lock.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY product-studio/ ./
RUN pnpm build && pnpm prune --prod

FROM ${BASE_IMAGE}

ARG APP_REVISION=unknown
LABEL org.opencontainers.image.revision=${APP_REVISION}

RUN set -eux; \
    test -f /app/product-studio/package.json; \
    test -f /app/product-studio/pnpm-lock.yaml; \
    cp /app/product-studio/package.json /tmp/base-product-studio-package.json; \
    cp /app/product-studio/pnpm-lock.yaml /tmp/base-product-studio-pnpm-lock.yaml; \
    find /app -mindepth 1 -maxdepth 1 ! -name .venv ! -name product-studio -exec rm -rf '{}' +; \
    find /app/product-studio -mindepth 1 -maxdepth 1 ! -name node_modules -exec rm -rf '{}' +

COPY . /app
COPY --from=web /build/product-studio/dist /app/product-studio/dist

WORKDIR /app
RUN cmp /tmp/base-product-studio-package.json /app/product-studio/package.json \
    && cmp /tmp/base-product-studio-pnpm-lock.yaml /app/product-studio/pnpm-lock.yaml \
    && rm /tmp/base-product-studio-package.json /tmp/base-product-studio-pnpm-lock.yaml \
    && test -d /app/product-studio/node_modules \
    && ln -sfn /usr/local/bin/python3.11 /app/.venv/bin/python \
    && chmod +x /app/scripts/docker-entrypoint.sh \
    && mkdir -p /app/checkpoints /app/outputs /app/runtime-output /app/artifacts \
    && /app/.venv/bin/python -c "import sys, indextts; assert sys.prefix == '/app/.venv', sys.prefix" \
    && /opt/voice-venv/bin/python -c "import importlib.util; assert importlib.util.find_spec('qwen_tts')"
